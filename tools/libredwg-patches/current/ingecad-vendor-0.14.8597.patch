#
# - classes.c object_alias: the ACDB_*OBJECTCONTEXTDATA_CLASS branch tested
#   "ACAD_" (its own comment says ACDB_), so every context object was
#   "Unhandled 0 ACDB_..._CLASS (objects)" and dropped by dxf2dwg;

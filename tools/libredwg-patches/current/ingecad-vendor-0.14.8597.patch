+    case code:                                                                \
+      d->field = pair->value.i ? 1 : 0;                                       \
+      LOG_TRACE ("%s.dimension." #field " = %d [B %d]\n", obj->name,          \
+                 d->field, code);                                             \
+      return 1
+      OCD_B (293, b293);
+      OCD_B (294, is_def_textloc);
+      OCD_B (298, dimtofl);

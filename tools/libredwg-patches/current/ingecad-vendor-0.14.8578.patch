+static void
+record_XY (double v, double *lo, double *hi)
+{
+  if (!isfinite (v) || in_block_definition)
+    return;
+  coords_drawn++;
+  if (v < *lo)
+    *lo = v;
+  if (v > *hi)
+    *hi = v;
+}

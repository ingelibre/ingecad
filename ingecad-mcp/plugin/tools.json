  {
    "type": "function",
    "function": {
      "name": "create_entities",
      "description": "Create a single undoable batch (1..1000). Specs: LINE(start,end), CIRCLE(center,radius), LWPOLYLINE(points,closed), TEXT(position,text,height,rotation,style), DIMENSION(start,end,location,angle,text,dimstyle). Each accepts an existing layer (default 0). Points are [x,y] or [x,y,z]; sizes use drawing units.",
      "parameters": {
        "properties": {
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "LINE",
                    "CIRCLE",
                    "LWPOLYLINE",
                    "TEXT",
                    "DIMENSION"
                  ]
                },
                "layer": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "rotation": {
                  "type": "number"
                },
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "start": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 3
                },
                "end": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 3
                },
                "center": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 3
                },
                "points": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 3
                  },
                  "minItems": 2
                },
                "closed": {
                  "type": "boolean"
                },
                "position": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 3
                },
                "location": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 3
                },
                "angle": {
                  "type": "number"
                },
                "style": {
                  "type": "string"
                },
                "dimstyle": {
                  "type": "string"
                }
              }
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "space": {
            "default": "Model",
            "title": "Space",
            "type": "string"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Revision"
          }
        },
        "required": [
          "entities"
        ],
        "title": "create_entitiesArguments",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_entities",

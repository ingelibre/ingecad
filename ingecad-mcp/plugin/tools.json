            "type": "array"
          },
          "attributes": {
            "type": "object",
            "properties": {
              "layer": {
                "type": "string"
              },
              "color": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              },
              "linetype": {
                "type": "string"
              },
              "lineweight": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "rotation": {
                "type": "number"
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "start": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 3
              },
              "end": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 3
              },
              "center": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 3
              },
              "insert": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 3
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "space": {
            "default": "Model",
            "title": "Space",
            "type": "string"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Revision"
          }
        },
        "required": [
          "handles",
          "attributes"
        ],
        "title": "update_entitiesArguments",
        "type": "object"
      }
    }
  },
